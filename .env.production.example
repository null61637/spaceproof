# Production settings for docker-compose.prod.yml.
# On the server: cp .env.production.example .env && chmod 600 .env
# Never commit .env. Fill in every value; compose refuses to start if one is missing.

# Public domain whose DNS A record points to the server (needed for HTTPS).
DOMAIN=

# PostgreSQL (only reachable inside the Docker network).
# POSTGRES_USER and POSTGRES_DB are inserted unescaped into DATABASE_URL: use
# only lowercase letters, digits and underscores, starting with a letter
# (e.g. spaceproof). Characters like @ : / ? # % or spaces break the connection.
# Data lives in a Docker volume: `docker compose ... down -v` deletes it.
POSTGRES_USER=spaceproof
POSTGRES_DB=spaceproof
# Generate on the server: openssl rand -hex 32   (hex keeps the connection URL valid)
POSTGRES_PASSWORD=

# Basic auth for the whole site, including /api.
BASIC_AUTH_USER=
# bcrypt hash, generated with:
#   docker run --rm -it caddy:2.11-alpine caddy hash-password
# Keep the SINGLE quotes: the hash contains "$", which compose would otherwise expand.
BASIC_AUTH_HASH=''
