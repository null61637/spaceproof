# Copy to .env and fill in. Never commit .env.

# Private key (0x + 64 hex) of the wallet that deploys the contract. That
# wallet becomes the contract's owner: the only account that can anchor, so it
# is the same key the backend will sign with (ANCHOR_PRIVATE_KEY).
# Use a key created only for Fuji, holding test AVAX and nothing of value.
ANCHOR_PRIVATE_KEY=

# Optional. Defaults to the public Fuji C-Chain RPC.
# ANCHOR_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
