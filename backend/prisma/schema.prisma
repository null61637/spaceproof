generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// Prisma 7: the connection URL lives in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

// Records are immutable once created (enforced by a database trigger, see the
// certificate_integrity migration); only txHash may be filled in once, by the
// owner role. They cannot be deleted (certificate_no_delete migration).
//
// hashVersion selects the canonical form behind contentHash:
//   1 = title + recipient only; every file and satellite column is NULL.
//   2 = manifest binding a file to its metadata (docs/manifiesto-v2.md).
// CHECK constraints (certificate_file_manifest migration) enforce both shapes.
// The file itself is never stored: only its hash, size and name.
model Certificate {
  id          String   @id @default(uuid())
  title       String
  recipient   String
  // SHA-256 of the canonical record or manifest, computed by the backend
  // (certificate-hash.ts). This is the hash that gets anchored.
  contentHash String   @unique @db.Char(64)
  txHash      String?
  createdAt   DateTime @default(now())

  hashVersion   Int       @default(1)
  // SHA-256 of the file bytes, computed by the backend while streaming.
  fileSha256    String?   @db.Char(64)
  fileSizeBytes BigInt?
  // Informational only: not part of the manifest.
  fileName      String?
  satellite     String?
  sensor        String?
  sceneId       String?
  acquiredAt    DateTime?
}
