generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// Prisma 7: the connection URL lives in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

// Records are immutable once created (enforced by a database trigger, see the
// certificate_integrity migration); only txHash may be filled in once, by the
// owner role. They cannot be deleted (certificate_no_delete migration).
//
// hashVersion selects the canonical form behind contentHash:
//   1 = title + recipient only; every file and satellite column is NULL.
//   2 = manifest binding a file to its metadata (docs/manifiesto-v2.md).
// CHECK constraints (certificate_file_manifest migration) enforce both shapes.
// The file itself is never stored: only its hash, size and name.
model Certificate {
  id          String   @id @default(uuid())
  title       String
  recipient   String
  // SHA-256 of the canonical record or manifest, computed by the backend
  // (certificate-hash.ts). This is the hash that gets anchored.
  contentHash String   @unique @db.Char(64)
  txHash      String?
  createdAt   DateTime @default(now())

  hashVersion   Int       @default(1)
  // SHA-256 of the file bytes, computed by the backend while streaming.
  fileSha256    String?   @db.Char(64)
  fileSizeBytes BigInt?
  // Informational only: not part of the manifest.
  fileName      String?
  satellite     String?
  sensor        String?
  sceneId       String?
  acquiredAt    DateTime?

  // Absent for certificates issued before anchoring existed.
  anchor Anchor?
}

enum AnchorStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
}

// The anchoring of one certificate's contentHash in the SpaceProofAnchor
// contract. The chain is the source of truth: this row tracks the sending and
// keeps the link to the transaction.
//
// Rules enforced by the database (anchor migration, not modelled by Prisma):
// a row is born PENDING; CONFIRMED is final; certificateId, chainId and
// contractAddress never change; rows cannot be deleted. The runtime role may
// only UPDATE the columns from status to updatedAt.
model Anchor {
  id              String      @id @default(uuid())
  certificateId   String      @unique
  certificate     Certificate @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  chainId         Int
  contractAddress String      @db.Char(42)
  createdAt       DateTime    @default(now())

  status      AnchorStatus @default(PENDING)
  txHash      String?      @db.Char(66)
  blockNumber BigInt?
  // Block timestamp the contract stored for the hash.
  anchoredAt  DateTime?
  attempts    Int          @default(0)
  // Error name or code only: never a message, a URL or request data.
  lastError   String?
  updatedAt   DateTime     @updatedAt
}
