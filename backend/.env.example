# Copy to .env and fill in values. Never commit .env.

# Used by docker-compose.yml
POSTGRES_USER=spaceproof
POSTGRES_PASSWORD=change_me
POSTGRES_DB=spaceproof
POSTGRES_PORT=5432

# Used by Prisma and NestJS (must match the values above)
DATABASE_URL="postgresql://spaceproof:change_me@localhost:5432/spaceproof?schema=public"

PORT=3001
