# Copy to .env and fill in values. Never commit .env.
# Generate each password with: openssl rand -hex 32  (hex keeps the URLs valid)

# Used by docker-compose.yml. POSTGRES_USER is the admin superuser: it only runs
# db/init/10-roles.sh (`pnpm db:bootstrap`). Never use it from the app or Prisma.
POSTGRES_USER=spaceproof
POSTGRES_PASSWORD=change_me
POSTGRES_DB=spaceproof
POSTGRES_PORT=5432

# Passwords of the roles created by db/init/10-roles.sh.
SPACEPROOF_OWNER_PASSWORD=change_me_owner
SPACEPROOF_APP_PASSWORD=change_me_app

# NestJS runtime: spaceproof_app (SELECT and INSERT only).
DATABASE_URL="postgresql://spaceproof_app:change_me_app@localhost:5432/spaceproof?schema=public"

# Prisma CLI (migrations): spaceproof_owner, which owns the tables.
MIGRATION_DATABASE_URL="postgresql://spaceproof_owner:change_me_owner@localhost:5432/spaceproof?schema=public"
SHADOW_DATABASE_URL="postgresql://spaceproof_owner:change_me_owner@localhost:5432/spaceproof_shadow?schema=public"

PORT=3001

# Optional: read-only link to the SpaceProofAnchor contract on Avalanche Fuji
# (public data, see contracts/deployments/fuji.json). Set both or neither.
# Without them, verification answers "not verifiable", never "valid".
# ANCHOR_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# ANCHOR_CONTRACT_ADDRESS=0xb5cA7811682676e0B7a8fc568B28dbf6f841c8CF
